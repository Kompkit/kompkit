{
  "name": "kompkit-core",
  "version": "0.3.0-alpha.0",
  "description": "Cross-platform utility functions for web applications. Part of the KompKit ecosystem.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kompkit/KompKit.git",
    "directory": "packages/core/web"
  },
  "homepage": "https://github.com/Kompkit/KompKit",
  "bugs": "https://github.com/Kompkit/KompKit/issues",
  "keywords": [
    "utilities",
    "debounce",
    "validation",
    "email",
    "currency",
    "format",
    "cross-platform"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "docs": "typedoc"
  },
  "devDependencies": {
    "typedoc": "^0.28.16",
    "vitest": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
